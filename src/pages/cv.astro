---
import Base from '../layouts/Base.astro';
import CvPub from '../components/CvPub.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { inlineMd } from '../lib/format';
import { getSite } from '../lib/site';

type Pub = CollectionEntry<'publications'>;
const inOrder = <T extends { data: { order: number } }>(xs: T[]) => xs.sort((a, b) => a.data.order - b.data.order);

const site = await getSite();
const t = site.cv; // section titles and labels
const pubs = inOrder(await getCollection('publications'));
const newest = (a: Pub, b: Pub) => b.data.year - a.data.year; // stable: keeps file order within a year
const of = (fn: (p: Pub) => boolean) => pubs.filter(fn).sort(newest);

const groups = [
  { title: t.journals, prefix: 'J', items: of((p) => p.data.type === 'journal') },
  { title: t.preprints, prefix: 'P', items: of((p) => p.data.type === 'preprint') },
  { title: t.selected_conferences, prefix: 'S', items: of((p) => p.data.type === 'conference' && p.data.selected) },
  { title: t.patents, prefix: 'PAT', items: of((p) => p.data.type === 'patent') },
];
const confGroups = [
  { title: t.international, prefix: 'C', items: of((p) => p.data.type === 'conference' && !p.data.selected && p.data.scope !== 'domestic') },
  { title: t.domestic, prefix: 'D', items: of((p) => p.data.type === 'conference' && !p.data.selected && p.data.scope === 'domestic') },
];
// Newest item gets the highest number; the year is shown once per year.
const rows = (items: Pub[], prefix: string) =>
  items.map((p, i) => ({
    p,
    label: `${prefix}${items.length - i}`,
    showYear: i === 0 || items[i - 1].data.year !== p.data.year,
  }));

const yr = (s: string) => (s === 'Present' ? 'present' : s.slice(0, 4));
const span = (start: string, end: string) => (yr(start) === yr(end) ? yr(start) : `${yr(start)}–${yr(end)}`);

const education = inOrder(await getCollection('education'));
const experience = inOrder(await getCollection('experience'));
const awards = inOrder(await getCollection('awards')).sort((a, b) => b.data.year - a.data.year);
const updated = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long' });
const scholar = site.links.find((l) => l.label === 'Google Scholar');
---
<Base title={site.menu.cv}>
  <article class="cv">
    <header class="cv-head">
      <div>
        <div class="cv-kicker">{t.kicker}</div>
        <h1 class="cv-name">{site.display_name}</h1>
        <div class="cv-contact">
          {site.role}, {site.affiliation}<br />
          {site.location && <>{site.location}<br /></>}
          {site.emails.map((e, i) => <>{i > 0 && ' · '}<a href={`mailto:${e}`}>{e}</a></>)}
          {scholar && <> · <a href={scholar.url}>Google Scholar</a></>}
        </div>
      </div>
      <a class="cv-download" href="/cv.pdf" download={t.download_filename}>
        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M8 1a.75.75 0 0 1 .75.75v6.69l2.22-2.22a.75.75 0 1 1 1.06 1.06l-3.5 3.5a.75.75 0 0 1-1.06 0l-3.5-3.5a.75.75 0 0 1 1.06-1.06l2.22 2.22V1.75A.75.75 0 0 1 8 1ZM2.75 12.5a.75.75 0 0 0 0 1.5h10.5a.75.75 0 0 0 0-1.5H2.75Z"/></svg>
        {t.download_button}
      </a>
    </header>

    <section>
      <h2>{t.research_interests}</h2>
      <p class="cv-text">{site.interests.join(' · ')}</p>
    </section>

    <section>
      <h2>{t.education}</h2>
      {education.map(({ data: e }) => (
        <div class="cv-row">
          <div class="cv-when">{span(e.start, e.end)}</div>
          <div class="cv-what">
            <strong>{e.degree} in {e.field}</strong>, {e.institution}{e.country && `, ${e.country}`}
            {e.advisor && <div class="cv-sub">{t.advisor}: {e.advisor}</div>}
            {e.extra.map((x) => <div class="cv-sub">{x}</div>)}
          </div>
        </div>
      ))}
    </section>

    <section>
      <h2>{t.experience}</h2>
      {experience.map(({ data: e }) => (
        <div class="cv-row">
          <div class="cv-when">{span(e.start, e.end)}</div>
          <div class="cv-what">
            <strong>{e.position}</strong>, {e.organization}
            {e.advisor && <span class="muted"> ({t.advisor}: {e.advisor})</span>}
            {e.bullets.map((b) => <div class="cv-sub" set:html={inlineMd(b)} />)}
          </div>
        </div>
      ))}
    </section>

    {groups.map((g) => g.items.length > 0 && (
      <section>
        <h2>{g.title}</h2>
        {g.prefix === 'J' && <p class="cv-legend">{t.journal_legend}</p>}
        {rows(g.items, g.prefix).map((r) => <CvPub pub={r.p} label={r.label} showYear={r.showYear} />)}
      </section>
    ))}

    <section>
      <h2>{t.conferences}</h2>
      {confGroups.map((g) => (
        <>
          <h3>{g.title}</h3>
          {rows(g.items, g.prefix).map((r) => <CvPub pub={r.p} label={r.label} showYear={r.showYear} />)}
        </>
      ))}
    </section>

    <section>
      <h2>{t.awards}</h2>
      {awards.map(({ data: a }) => (
        <div class="cv-row">
          <div class="cv-when">{a.year}</div>
          <div class="cv-what"><strong>{a.title}</strong>, {a.awarder}</div>
        </div>
      ))}
    </section>

    {site.skills.length > 0 && (
      <section>
        <h2>{t.skills}</h2>
        {site.skills.map((s) => <p class="cv-text">{s.replace(/,\s*$/, '')}</p>)}
      </section>
    )}

    <p class="cv-updated">{t.last_updated}: {updated}</p>
  </article>
</Base>
