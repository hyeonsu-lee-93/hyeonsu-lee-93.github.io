---
// Home. Texts: content/site.yaml, content/home.md, content/news/
import Base from '../layouts/Base.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { formatMonth, inlineMd } from '../lib/format';
import { getSite } from '../lib/site';

const site = await getSite();
const { Content: Bio } = await render((await getEntry('pages', 'home'))!);
const news = (await getCollection('news')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const rendered = await Promise.all(
  news.map(async (n) => ({ ...n, Content: (await render(n)).Content, hasBody: (n.body ?? '').trim().length > 0 })),
);
---
<Base>
  <section class="hero">
    <img src="/avatar.jpg" alt={site.name} width="150" />
    <div>
      <h1>{site.display_name}</h1>
      <p class="role">{site.role}, {site.affiliation_url ? <a href={site.affiliation_url}>{site.affiliation}</a> : site.affiliation}</p>
      <div class="bio"><Bio /></div>
      <ul class="tags">
        {site.interests.map((i) => <li>{i}</li>)}
      </ul>
      <div class="links">
        {site.emails.map((e) => <a href={`mailto:${e}`}>{e}</a>)}
        {site.links.map((l) => <a href={l.url} target="_blank" rel="noopener">{l.label}</a>)}
        <a href="/cv.pdf">{site.home.cv_link}</a>
      </div>
    </div>
  </section>

  <h2>{site.home.news_title}</h2>
  <ul class="news">
    {rendered.map((n) => (
      <li>
        <span class="date">{formatMonth(n.data.date.toISOString().slice(0, 7))}</span>
        <span class="item">
          {n.hasBody ? (
            <details>
              <summary set:html={inlineMd(n.data.title)} />
              <div class="body"><n.Content /></div>
            </details>
          ) : (
            <Fragment set:html={inlineMd(n.data.title)} />
          )}
        </span>
      </li>
    ))}
  </ul>
</Base>
